.env
.env.local
.env.*.local

# JobSpy scraper (jobspy_scan_parser.py): scrape cache + its own venv.
# python-jobspy can't be installed into Debian's system python (PEP 668).
.venv-jobspy/
jobspy_jobs.csv
jobspy_jobs_filtered.csv

# JobRight JD text cache (jobright_scan_parser.py) — refetchable, grows large
jobright_desc_cache.json

