# Personal data (user fills these)
data/applications.md
data/pipeline.md
data/scan-history.tsv
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# Secrets. scan.mjs loads .env via dotenv and jobright_scan_parser.py reads
# JOBRIGHT_COOKIE from it — a live session cookie must never be committed.
.env
.env.local
.env.*.local

# JobSpy scraper (jobspy_scan_parser.py): scrape cache + its own venv.
# python-jobspy can't be installed into Debian's system python (PEP 668).
.venv-jobspy/
jobspy_jobs.csv
jobspy_jobs_filtered.csv

# JobRight JD text cache (jobright_scan_parser.py) — refetchable, grows large
jobright_desc_cache.json

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
package-lock.json
jobright_apply_cache.json

# LinkedIn employer-apply-URL cache (linkedin_apply.py) — refetchable
linkedin_apply_cache.json

# Credentials for job-site accounts — never commit
Job_applicator/login.env
Job_applicator/profile.json

# Cached application answers (contains EEO + personal data)
Job_applicator/cache/
Job_applicator/answers/
Job_applicator/logs/

